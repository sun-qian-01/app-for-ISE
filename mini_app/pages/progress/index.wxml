<view class="container">
  <view class="card">
    <view class="row">
      <view class="card-title">当前阶段</view>
      <view class="badge">{{currentStage}}</view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">阶段记录</view>
    <view wx:for="{{records}}" wx:key="stageName" class="timeline-item">
      <view class="timeline-left">
        <view class="dot {{item.status}}"></view>
        <view class="line" wx:if="{{index !== records.length - 1}}"></view>
      </view>
      <view class="timeline-content">
        <view class="row">
          <view class="stage-name">{{item.stageName}}</view>
          <view class="stage-status">{{item.statusText}}</view>
        </view>
        <view class="muted">{{item.time}}</view>
        <view class="comment">{{item.comment}}</view>
      </view>
    </view>
  </view>
</view>
