.summary-row {
  display: flex;
  margin-top: 20rpx;
}

.summary-item {
  flex: 1;
}

.summary-num {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.entry-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.entry-item {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 18rpx;
}

.entry-title {
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.notice-item {
  border-top: 1rpx solid #eef2f7;
  padding: 16rpx 0;
}

.notice-title {
  margin-bottom: 6rpx;
}
