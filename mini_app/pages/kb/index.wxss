.search-row {
  display: flex;
  gap: 12rpx;
}

.search-input {
  flex: 1;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx;
}

.search-btn {
  width: 140rpx;
}

.category-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 12rpx;
}

.category-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef2f7;
  color: #475569;
  font-size: 24rpx;
}

.category-chip-active {
  background: #dbeafe;
  color: #1d4ed8;
}

.article-item {
  border-top: 1rpx solid #eef2f7;
  padding: 16rpx 0;
}

.article-title {
  font-weight: 600;
  margin-bottom: 8rpx;
}

.keyword-line {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}
