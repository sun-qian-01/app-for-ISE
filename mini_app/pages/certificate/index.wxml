<view class="container">
  <view class="card">
    <view class="card-title">发起新申请</view>

    <view class="field-label">证明模板</view>
    <picker
      mode="selector"
      range="{{templateOptions}}"
      range-key="name"
      bindchange="onTemplateChange"
    >
      <view class="picker">{{selectedTemplateName}}</view>
    </picker>

    <view class="field-label">用途说明</view>
    <textarea
      class="textarea"
      placeholder="例如：用于实习单位入职材料"
      value="{{purpose}}"
      bindinput="onPurposeInput"
    />

    <button class="btn-primary" bindtap="onSubmitApplication">提交申请</button>
  </view>

  <view class="card">
    <view class="card-title">我的申请记录</view>
    <view wx:for="{{applications}}" wx:key="id" class="record-item">
      <view class="row">
        <view class="record-title">{{item.templateName}}</view>
        <view class="badge">{{item.statusText}}</view>
      </view>
      <view class="muted">用途：{{item.purpose}}</view>
      <view class="muted">提交时间：{{item.createdAt}}</view>
      <button
        wx:if="{{item.status === 'submitted' || item.status === 'reviewing'}}"
        class="btn-secondary revoke-btn"
        size="mini"
        data-id="{{item.id}}"
        bindtap="onRevoke"
      >
        撤回申请
      </button>
    </view>
  </view>
</view>
